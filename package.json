{
  "name": "evorca",
  "version": "0.0.0",
  "private": true,
  "description": "A self-improving agent for autonomous incident investigation and root cause analysis.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvoTestOps/evorca.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
